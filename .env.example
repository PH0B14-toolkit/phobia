# PHOBIA environment file
# copy to phobia.env and fill in your values
# phobia.env is gitignored — never commit it

# Telegram bot for C2 module (create via @BotFather)
PHOBIA_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz-abc123"
PHOBIA_CHAT_ID="123456789"
PHOBIA_BOT_NAME="@your_bot_username"

# Wordlists path (override if you keep wordlists somewhere else)
PHOBIA_WORDLIST_DIR="/usr/share/wordlists"
